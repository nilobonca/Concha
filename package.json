{
  "name": "concha",
  "productName": "Concha",
  "version": "1.2.0",
  "description": "Concha Desktop Application",
  "author": "Nilo",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on tcp:3000 && electron electron/main.js\"",
    "electron:start": "electron electron/main.js",
    "electron:build": "next build && electron-builder --win",
    "electron:release": "next build && electron-builder --win -p always",
    "build:export": "cross-env NEXT_EXPORT=true next build",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run build:export && cap sync android",
    "apk:build": "npm run build:export && cap sync android && cd android && gradlew.bat assembleDebug && cd .."
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.0",
    "@tiptap/extension-highlight": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-table-cell": "^3.31.0",
    "@tiptap/extension-table-header": "^3.31.0",
    "@tiptap/extension-table-row": "^3.31.0",
    "@tiptap/extension-task-item": "^3.31.0",
    "@tiptap/extension-task-list": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@types/d3": "^7.4.3",
    "@types/marked": "^5.0.2",
    "@types/turndown": "^5.0.6",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "electron-updater": "^6.8.9",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.24",
    "fuse.js": "^7.5.0",
    "js-yaml": "^4.3.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.545.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "next": "^16.0.7",
    "peerjs": "^1.5.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}